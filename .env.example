# --- API (control plane) ---
API_PORT=8080
# JWT_SECRET signs auth tokens and is required by the API.
# Generate one with: openssl rand -base64 32
JWT_SECRET=
JWT_TTL=1h
MIGRATIONS_DIR=migrations
LOG_LEVEL=info

# --- Secrets at rest ---
# AES-256-GCM key (base64) used to encrypt cloud-connector credentials and
# MFA (TOTP) secrets. Generate one with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# --- Database ---
DB_USER=castracloud
DB_PASS=castracloud
DB_HOST=localhost
DB_PORT=5432
DB_NAME=castracloud
DB_SSLMODE=disable

# --- CSPM ---
CSPM_PROVIDER=aws
AWS_REGION=us-east-1
# How often the API re-scans all configured connectors in the background.
SCAN_INTERVAL=24h
# AWS credentials are read from the standard chain (env, ~/.aws/credentials, IAM role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# GCP: read-only service account via Application Default Credentials.
# Set GOOGLE_APPLICATION_CREDENTIALS to a service account key file, or rely on
# GCE metadata. GCP_PROJECT falls back to the ADC project.
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Azure: DefaultAzureCredential (managed identity or AZURE_TENANT_ID/CLIENT_ID/CLIENT_SECRET).
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
CSPM_TENANT_ID=
CSPM_API_URL=http://localhost:8080
# A JWT issued by POST /v1/auth/login (subject needs findings:write).
CSPM_API_TOKEN=

# --- SSO / OIDC (optional) ---
# When OIDC_ISSUER is set, the API exposes GET /v1/auth/oidc/start and
# /v1/auth/oidc/callback. OIDC_REDIRECT_URL must point at the API callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/v1/auth/oidc/callback
OIDC_TENANT_SLUG=default
# Where to send the browser after a successful SSO login (the console).
OIDC_REDIRECT_AFTER=http://localhost:3000/

# --- Console ---
NEXT_PUBLIC_API_URL=http://localhost:8080
# Set to "true" to show the "Continue with SSO" button on the login page.
NEXT_PUBLIC_OIDC_ENABLED=false

# --- AI assistant (bring your own key) ---
# Any OpenAI-compatible chat completions API. Leave AI_API_KEY empty to disable.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Examples:
#   OpenAI:     AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1 AI_MODEL=openai/gpt-4o-mini
#   Ollama:     AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=llama3.1
